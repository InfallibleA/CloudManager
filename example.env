# Postgres
DB_SCHEME=postgresql+asyncpg
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Порт на хосте для подключения извне (контейнер всегда слушает 5432)
POSTGRES_HOST_PORT=5439
POSTGRES_DB=cloud_manager
POSTGRES_USER=cloud_manager_user
POSTGRES_PASSWORD=cloud_manager_password
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=5

# App
APP_NAME=cloud_manager
APP_VERSION=1.0
APP_HOST=127.0.0.1
APP_PORT=8000
# Порт nginx-шлюза, публикуемый на хост (весь API-трафик идёт через него)
GATEWAY_PORT=80

# JWT. JWT_SECRET_KEY обязательно заменить в продакшене
JWT_SECRET_KEY=dev-only-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Garage (S3-совместимое хранилище). Доступы соответствуют garage/garage.toml,
# бакет и ключ создаются командами инициализации из README.
# GARAGE_HOST/GARAGE_PORT — адрес S3 API внутри docker-сети: из них compose собирает
# S3_ENDPOINT для приложения, их же подставляет шаблонизатор nginx в прокси
# /cloudmanager-files/. Порт должен совпадать с api_bind_addr в garage/garage.toml
GARAGE_HOST=garage
GARAGE_PORT=3900
# Порт S3 API, публикуемый на хост (нужен только для локальной разработки)
GARAGE_HOST_PORT=3900
# S3_ENDPOINT подставляется автоматически как ${GARAGE_HOST}:${GARAGE_PORT}.
# Задавайте вручную, только если приложение запускается без Docker, например:
# S3_ENDPOINT=localhost:3900
S3_REGION=garage
S3_ACCESS_KEY=GK636c6f75645f6d616e6167657200000001
S3_SECRET_KEY=636c6f75645f6d616e616765722d6465762d7365637265742d6e6f742d666f722d70726f64
S3_BUCKET=cloudmanager-files
S3_SECURE=false
# Публичный адрес Garage со стороны браузера: по нему подписываются presigned-ссылки
# на видео. В dev — origin сайта (nginx-шлюз), в проде — https://<домен>.
S3_PUBLIC_ENDPOINT=http://localhost

# Ограничение размера загружаемого файла, МБ
FILE_MAX_SIZE_MB=20

# Видео: ограничение размера файла, МБ, и время жизни presigned-ссылки, сек
VIDEO_MAX_SIZE_MB=2048
VIDEO_PRESIGN_TTL_SECONDS=21600

# CORS: домены сайта и админки через запятую, например
# CORS_ORIGINS=https://cloudmanager.ru,https://www.cloudmanager.ru
# `*` разрешает любой домен, но тогда CORS_ALLOW_CREDENTIALS должен быть false
# (браузер отклонит ответ с `*` и cookies одновременно)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false